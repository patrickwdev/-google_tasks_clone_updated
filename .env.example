# Supabase (required for auth)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# For email confirmation to open the app and auto sign-in, add redirect URL in Supabase:
# Auth → URL Configuration → Redirect URLs → add: myapp://**

# Google Places API (optional – for location autocomplete when adding "When I'm nearby")
# Enable Places API (New): https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# Web: use one key, restrict to "HTTP referrers" and add e.g. http://localhost:8081/*
# Android: use a separate key, restrict to "Android apps" and add your package name + SHA-1
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
